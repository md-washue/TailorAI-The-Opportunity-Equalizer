\pagestyle{fancy}
\fancyhf{} % clear all header and footer fields
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

% Adjust margins
\addtolength{\oddsidemargin}{-0.5in}
\addtolength{\evensidemargin}{-0.5in}
\addtolength{\textwidth}{1in}
\addtolength{\topmargin}{-.5in}
\addtolength{\textheight}{1.0in}

\urlstyle{same}

\raggedbottom
\raggedright
\setlength{\tabcolsep}{0in}

% Sections formatting
\titleformat{\section}{
  \vspace{-4pt}\scshape\raggedright\large
}{}{0em}{}[\color{black}\titlerule \vspace{-5pt}]

\begin{document}

%----------HEADING----------
\begin{center}
    {\Huge \scshape \VAR{resume.name | tex}} \\ \vspace{2pt}
    \small \VAR{resume.contact_line | tex}
\end{center}

\BLOCK{if resume.education}
%-----------EDUCATION-----------
\section{Education}
  \begin{itemize}[leftmargin=0.15in, label={}]
    \BLOCK{for edu in resume.education}
    \item
      \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{\VAR{edu.institution | tex}} & \VAR{edu.dates | tex} \\
        \textit{\small \VAR{edu.degree | tex}} & \\
      \end{tabular*}\vspace{-5pt}
    \BLOCK{endfor}
  \end{itemize}
\BLOCK{endif}

\BLOCK{if resume.experience}
%-----------EXPERIENCE-----------
\section{Experience}
  \begin{itemize}[leftmargin=0.15in, label={}]
    \BLOCK{for exp in resume.experience}
    \item
      \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{\VAR{exp.role | tex}} & \VAR{exp.dates | tex} \\
        \textit{\small \VAR{exp.company | tex}} & \\
      \end{tabular*}\vspace{-5pt}
      \BLOCK{if exp.bullets}
      \begin{itemize}[leftmargin=0.2in, label=\textbullet]
        \BLOCK{for bullet in exp.bullets}
        \item \VAR{bullet | tex}
        \BLOCK{endfor}
      \end{itemize}
      \BLOCK{endif}
      \vspace{2pt}
    \BLOCK{endfor}
  \end{itemize}
\BLOCK{endif}

\BLOCK{if resume.projects}
%-----------PROJECTS-----------
\section{Projects}
  \begin{itemize}[leftmargin=0.15in, label={}]
    \BLOCK{for proj in resume.projects}
    \item
      \begin{tabular*}{0.97\textwidth}[t]{l@{\extracolsep{\fill}}r}
        \textbf{\VAR{proj.name | tex}} \BLOCK{if proj.tech_stack}$|$ \small \textit{\VAR{proj.tech_stack | tex}}\BLOCK{endif} & \\
      \end{tabular*}\vspace{-5pt}
      \BLOCK{if proj.bullets}
      \begin{itemize}[leftmargin=0.2in, label=\textbullet]
        \BLOCK{for bullet in proj.bullets}
        \item \VAR{bullet | tex}
        \BLOCK{endfor}
      \end{itemize}
      \BLOCK{endif}
      \vspace{2pt}
    \BLOCK{endfor}
  \end{itemize}
\BLOCK{endif}

\BLOCK{if resume.skills}
%-----------TECHNICAL SKILLS-----------
\section{Technical Skills}
 \begin{itemize}[leftmargin=0.15in, label={}]
    \item \small{\textbf{Skills}{: \BLOCK{for s in resume.skills}\VAR{s | tex}\BLOCK{if not loop.last}, \BLOCK{endif}\BLOCK{endfor}}}
 \end{itemize}
\BLOCK{endif}

