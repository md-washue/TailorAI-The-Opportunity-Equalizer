%----------------------------------------------------------------------------------------
% TailorAI - Standalone Medium Length Professional CV Template
% Adapted from Trey Hunner's resume.cls for standalone 1-click compilation
%----------------------------------------------------------------------------------------

\documentclass[11pt,letterpaper]{article}

\usepackage[margin=0.6in]{geometry}
\usepackage[parfill]{parskip}
\usepackage{array}
\usepackage{tabularx}
\usepackage{ifthen}
\usepackage{enumitem}
\usepackage[colorlinks=true, linkcolor=blue, urlcolor=blue]{hyperref}

\pagestyle{empty}

%----------------------------------------------------------------------------------------
% HEADINGS COMMANDS: Spacing for section headings
%----------------------------------------------------------------------------------------

\def\nameskip{\bigskip}
\def\sectionskip{\medskip}
\def\sectionlineskip{\medskip}

% Defines the rSection environment for large sections within the CV
\newenvironment{rSection}[1]{%
  \sectionskip
  \MakeUppercase{\textbf{#1}}%
  \sectionlineskip
  \hrule
  \begin{list}{}{%
    \setlength{\leftmargin}{0em}%
  }%
  \item[]
}{%
  \end{list}%
}

% Defines the rSubsection environment for experience/project entries
\newenvironment{rSubsection}[4]{%
  {\textbf{#1}} \hfill {#2}%
  \ifthenelse{\equal{#3}{}}{}{%
    \\
    {\textit{#3}} \hfill {\textit{#4}}%
  }\smallskip
  \begin{list}{$\cdot$}{%
    \setlength{\leftmargin}{1.0em}%
    \setlength{\itemsep}{-0.4em}%
    \vspace{-0.5em}%
  }%
}{%
  \end{list}%
  \vspace{0.3em}%
}

\begin{document}

%----------HEADING----------
\begin{center}
    {\LARGE \textbf{\MakeUppercase{\VAR{resume.name | tex}}}} \\ \smallskip
    \VAR{resume.contact_line | tex}
\end{center}

\BLOCK{if resume.summary}
%-----------PERSONAL SUMMARY-----------
\begin{rSection}{Personal Summary}
  \VAR{resume.summary | tex}
\end{rSection}
\BLOCK{endif}

\BLOCK{if resume.skill_categories}
%-----------SKILLS-----------
\begin{rSection}{Skills}
  \begin{tabularx}{\textwidth}{@{}l X@{}}
    \BLOCK{for sc in resume.skill_categories}
    \textbf{\VAR{sc.category | tex}:} & \VAR{sc.items | tex} \\
    \BLOCK{endfor}
  \end{tabularx}
\end{rSection}
\BLOCK{elif resume.skills}
%-----------SKILLS-----------
\begin{rSection}{Skills}
  \BLOCK{for s in resume.skills}\VAR{s | tex}\BLOCK{if not loop.last}, \BLOCK{endif}\BLOCK{endfor}
\end{rSection}
\BLOCK{endif}

\BLOCK{if resume.experience}
%-----------EXPERIENCE-----------
\begin{rSection}{Experience}
  \BLOCK{for exp in resume.experience}
  \begin{rSubsection}{\VAR{exp.company | tex}}{\VAR{exp.dates | tex}}{\VAR{exp.role | tex}}{}
    \BLOCK{for b in exp.bullets}
    \item \VAR{b | tex}
    \BLOCK{else}
    \item[]
    \BLOCK{endfor}
  \end{rSubsection}
  \BLOCK{endfor}
\end{rSection}
\BLOCK{endif}

\BLOCK{if resume.projects}
%-----------PROJECTS-----------
\begin{rSection}{Projects}
  \BLOCK{for proj in resume.projects}
  \begin{rSubsection}{\VAR{proj.name | tex}}{\VAR{proj.dates | tex}}{\VAR{proj.tech_stack | tex}}{}
    \BLOCK{for b in proj.bullets}
    \item \VAR{b | tex}
    \BLOCK{else}
    \item[]
    \BLOCK{endfor}
  \end{rSubsection}
  \BLOCK{endfor}
\end{rSection}
\BLOCK{endif}

\BLOCK{if resume.education}
%-----------EDUCATION-----------
\begin{rSection}{Education}
  \BLOCK{for edu in resume.education}
  \textbf{\VAR{edu.degree | tex}} \hfill \VAR{edu.dates | tex} \\
  \textit{\VAR{edu.institution | tex}} \BLOCK{if not loop.last}\smallskip\\ \BLOCK{endif}
  \BLOCK{endfor}
\end{rSection}
\BLOCK{endif}

\BLOCK{if resume.certifications}
%-----------CERTIFICATIONS & AWARDS-----------
\begin{rSection}{Certifications \& Awards}
  \begin{itemize}[leftmargin=1.0em, itemsep=-0.4em]
    \BLOCK{for cert in resume.certifications}
    \item \VAR{cert | tex}
    \BLOCK{endfor}
  \end{itemize}
\end{rSection}
\BLOCK{endif}

\end{document}
